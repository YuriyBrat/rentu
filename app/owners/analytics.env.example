# Optional public IDs. Copy the required variables into the local/hosting env,
# then restart/rebuild Next. Empty values keep external trackers disabled.
NEXT_PUBLIC_OWNERS_GA4_ID=
NEXT_PUBLIC_OWNERS_GOOGLE_ADS_ID=
NEXT_PUBLIC_OWNERS_GOOGLE_ADS_LABEL=
NEXT_PUBLIC_OWNERS_META_PIXEL_ID=

# GA4_ID: G-...; GOOGLE_ADS_ID: AW-...; LABEL: the conversion action's label.
# META_PIXEL_ID: numeric ID. Never put Telegram tokens or CRM secrets here.
# Trackers load only after the visitor's corresponding privacy choice.
# Main conversion: owners_submit_success, only after API-confirmed persistence.
# GA4: mark this event as a key event. Ads: choose EITHER the direct Ads action
# configured above OR an imported GA4 conversion as the primary action.
# Do not count the legacy owner_analysis_request alias as another conversion.
# Meta: create a custom conversion for owners_submit_success.
# Disable GA4 enhanced measurement for automatic form interactions/history
# page changes, and Meta automatic events/advanced matching. Only the six
# explicit owners_* events should measure this form; never configure PII
# variables or form-field collection. UTM values must not contain PII either.
# Do not add a second GTM/pixel snippet for these same IDs.
# Production account delivery still needs verification in GA DebugView,
# Google Tag Assistant, and Meta Test Events after real IDs are configured.
# Consent implementation reference:
# https://developers.google.com/tag-platform/security/concepts/consent-mode
